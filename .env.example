# Required: set a long random secret and share it only with the grader.
A2A_BEARER_TOKEN=replace-with-a-long-random-secret
# Public base URL submitted to the grader; must exactly match the deployed A2A route.
A2A_BASE_URL=https://your-service.onrender.com/a2a
# AI provider (OpenAI-compatible API)
OPENAI_API_KEY=replace-with-provider-key
OPENAI_BASE_URL=https://aipipe.org/openrouter/v1
OPENAI_MODEL=google/gemini-2.5-flash-lite
# Persistent disk path on your host
DATABASE_PATH=/var/data/invoice_agent.sqlite3
